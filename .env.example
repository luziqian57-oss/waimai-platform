# 复制为 .env 后替换。真实密钥不要提交到 Git。
MYSQL_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
REDIS_PASSWORD=replace-with-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=*

# 仅首次创建管理员时临时开启；创建成功后改回 false 并移除密码。
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MOCK_ENABLED=false
