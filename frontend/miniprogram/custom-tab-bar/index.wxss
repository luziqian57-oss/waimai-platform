.tab-shell { position: fixed; z-index: 999; left: 24rpx; right: 24rpx; bottom: calc(18rpx + env(safe-area-inset-bottom)); }
.tabbar { height: 112rpx; display: flex; align-items: center; padding: 0 13rpx; border: 1rpx solid rgba(255,255,255,.9); border-radius: 36rpx; background: rgba(250,250,252,.82); box-shadow: 0 18rpx 55rpx rgba(25,31,43,.16); backdrop-filter: blur(28px) saturate(155%); -webkit-backdrop-filter: blur(28px) saturate(155%); }
.tab { flex: 1; height: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 27rpx; color: #8b9099; }
.tab.active { color: #17191d; background: rgba(255,255,255,.82); box-shadow: 0 8rpx 22rpx rgba(28,34,46,.08); }
.icon { height: 40rpx; line-height: 40rpx; font-size: 31rpx; font-weight: 600; }
.active .icon { color: #ee5a34; transform: translateY(-1rpx); }
.label { margin-top: 3rpx; font-size: 20rpx; font-weight: 600; }
