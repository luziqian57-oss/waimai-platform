.addresses-page { padding-top: 34rpx; }
.page-heading { padding: 8rpx 6rpx 30rpx; }
.page-heading .title { margin-top: 10rpx; font-size: 50rpx; }
.add-button { width: 78rpx; min-width: 78rpx; height: 78rpx; line-height: 72rpx; margin: 0; padding: 0; border-radius: 26rpx; background: #1d1f23; color: #fff; font-size: 42rpx; box-shadow: 0 12rpx 25rpx rgba(20,22,26,.18); }
.empty-button { width: 310rpx; margin-top: 34rpx; }
.address-top { align-items: flex-start; }
.address-title { font-size: 30rpx; font-weight: 700; }.address-title text { margin-left: 10rpx; color: #757b84; font-size: 24rpx; font-weight: 400; }
.default-badge { padding: 8rpx 15rpx; border-radius: 999rpx; background: #fff0ea; color: #eb5a34; font-size: 20rpx; font-weight: 650; }
.address-detail { margin-top: 18rpx; color: #454a52; line-height: 1.55; }
.address-actions { margin-top: 25rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(60,60,67,.08); }
.set-default { display: flex; align-items: center; gap: 10rpx; color: #7e848d; font-size: 23rpx; }
.set-default.selected { color: #e75a34; }
.radio { width: 34rpx; height: 34rpx; line-height: 34rpx; border: 2rpx solid #c5c9cf; border-radius: 50%; text-align: center; font-size: 19rpx; }
.selected .radio { border-color: #ff6840; background: #ff6840; color: #fff; }
.action-buttons { gap: 10rpx; }.action-buttons button { min-height: 58rpx; height: 58rpx; line-height: 56rpx; margin: 0; padding: 0 22rpx; font-size: 22rpx; }
.delete { background: transparent; color: #d73b32; }
.sheet-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(16,19,24,.28); }
.sheet { width: 100%; max-height: 88vh; overflow-y: auto; box-sizing: border-box; border-radius: 42rpx 42rpx 0 0; padding: 18rpx 32rpx calc(38rpx + env(safe-area-inset-bottom)); background: rgba(249,250,252,.92); }
.sheet-handle { width: 82rpx; height: 9rpx; margin: 0 auto 26rpx; border-radius: 999rpx; background: rgba(60,60,67,.2); }
.sheet-head { margin-bottom: 24rpx; }.sheet-head .section-title { margin-top: 7rpx; font-size: 35rpx; }
.close { width: 62rpx; min-width: 62rpx; height: 62rpx; line-height: 56rpx; margin: 0; padding: 0; border-radius: 50%; background: rgba(118,118,128,.11); color: #626871; font-size: 38rpx; }
.field { padding: 17rpx 23rpx; margin-top: 14rpx; border-radius: 21rpx; background: rgba(255,255,255,.8); border: 1rpx solid rgba(60,60,67,.07); }
.label { color: #858b94; font-size: 20rpx; font-weight: 600; }.field input { height: 49rpx; margin-top: 4rpx; font-size: 27rpx; }
.picker-value { margin-top: 10rpx; font-size: 27rpx; }.picker-value text { float: right; color: #b0b5bc; font-size: 34rpx; }
.default-switch { margin: 24rpx 5rpx; }
.save { margin-top: 20rpx; }
