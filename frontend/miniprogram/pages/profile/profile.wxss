.profile-page { min-height: 100vh; position: relative; overflow: hidden; }
.profile-glow { position: absolute; width: 580rpx; height: 580rpx; top: -300rpx; right: -210rpx; border-radius: 50%; background: radial-gradient(circle,#ffc5ac 0%,rgba(255,197,172,0) 70%); }
.content { position: relative; z-index: 1; padding-top: 34rpx; }
.page-heading { padding: 8rpx 6rpx 30rpx; }
.page-heading .title { margin-top: 10rpx; font-size: 50rpx; }
.profile-card { padding: 38rpx 32rpx; border-radius: 36rpx; text-align: center; }
.avatar { width: 122rpx; height: 122rpx; line-height: 122rpx; margin: 0 auto; border-radius: 40rpx; background: linear-gradient(145deg,#ff8a60,#ee4e2b); color: #fff; font-size: 48rpx; font-weight: 750; box-shadow: 0 16rpx 36rpx rgba(238,78,43,.22); }
.identity { margin-top: 24rpx; }
.name { font-size: 35rpx; font-weight: 700; }
.login { width: 280rpx; margin-top: 28rpx; }
.section-label { margin: 34rpx 10rpx 14rpx; color: #888e97; font-size: 23rpx; font-weight: 600; }
.menu-card { padding: 0 28rpx; }
.menu-row { min-height: 120rpx; display: flex; align-items: center; gap: 20rpx; border-bottom: 1rpx solid rgba(60,60,67,.08); }
.menu-row:last-child { border-bottom: 0; }
.menu-icon { width: 66rpx; height: 66rpx; line-height: 66rpx; flex: 0 0 66rpx; border-radius: 20rpx; text-align: center; font-weight: 700; }
.orange { color: #eb5b35; background: #fff0ea; }.blue { color: #367cc8; background: #eaf3ff; }.green { color: #258842; background: #e9f8ed; }.purple { color: #7755ba; background: #f1ebff; }
.menu-text { min-width: 0; flex: 1; font-weight: 600; }
.menu-text text { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #9297a0; font-size: 21rpx; font-weight: 400; margin-top: 5rpx; }
.online { color: #23833f; font-size: 22rpx; }
.logout { margin-top: 30rpx; border-radius: 999rpx; background: rgba(255,59,48,.08); color: #d6342c; font-size: 27rpx; }
