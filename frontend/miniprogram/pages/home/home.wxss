.home-page { min-height: 100vh; position: relative; overflow: hidden; background: linear-gradient(180deg, #fafbfc 0%, #f0f2f6 68%); }
.content { position: relative; z-index: 1; padding: 34rpx 26rpx 0; }
.ambient { position: absolute; border-radius: 50%; filter: blur(10rpx); opacity: .42; }
.ambient-one { width: 500rpx; height: 500rpx; right: -190rpx; top: -230rpx; background: radial-gradient(circle, #ffc4a6 0%, rgba(255,196,166,0) 70%); }
.ambient-two { width: 420rpx; height: 420rpx; left: -220rpx; top: 250rpx; background: radial-gradient(circle, #c5d7ff 0%, rgba(197,215,255,0) 72%); }
.topline { padding: 10rpx 8rpx 30rpx; }
.greeting { margin-top: 10rpx; font-size: 42rpx; font-weight: 750; letter-spacing: -2rpx; }
.avatar { width: 78rpx; height: 78rpx; line-height: 78rpx; border-radius: 25rpx; text-align: center; color: #fff; font-weight: 700; background: linear-gradient(145deg,#ff8b62,#ef4e2b); box-shadow: 0 12rpx 30rpx rgba(238,78,43,.22); }
.shop-tabs { white-space: nowrap; margin-bottom: 18rpx; }
.shop-tab { display: inline-block; padding: 15rpx 28rpx; background: rgba(255,255,255,.72); border-radius: 999rpx; margin-right: 14rpx; color: #707680; }
.shop-tab.active { background: #1e2024; color: #fff; }
.hero { position: relative; overflow: hidden; padding: 34rpx; border-radius: 34rpx; margin-bottom: 24rpx; }
.hero::after { content: ''; position: absolute; right: -40rpx; bottom: -60rpx; width: 220rpx; height: 220rpx; border-radius: 50%; background: linear-gradient(145deg,rgba(255,142,98,.32),rgba(255,255,255,0)); }
.hero-badge { display: inline-block; padding: 8rpx 16rpx; border-radius: 999rpx; background: rgba(52,199,89,.13); color: #21873c; font-size: 21rpx; font-weight: 650; }
.hero-title { margin-top: 22rpx; font-size: 40rpx; font-weight: 750; }
.hero-address { margin-top: 10rpx; color: #747a84; font-size: 23rpx; }
.hero-meta { display: flex; align-items: center; gap: 16rpx; margin-top: 28rpx; color: #555b64; font-size: 23rpx; }
.meta-strong { color: #17191d; font-size: 29rpx; font-weight: 700; }
.dot { width: 6rpx; height: 6rpx; border-radius: 50%; background: #b2b6bd; }
.menu { height: calc(100vh - 410rpx); min-height: 650rpx; display: flex; gap: 18rpx; overflow: hidden; padding-bottom: 120rpx; }
.categories { width: 170rpx; height: 100%; border-radius: 28rpx; box-sizing: border-box; padding: 12rpx; }
.category { position: relative; padding: 28rpx 12rpx; color: #858a93; text-align: center; border-radius: 20rpx; font-size: 24rpx; }
.category.active { color: #1d1f23; background: rgba(255,255,255,.95); font-weight: 650; box-shadow: 0 8rpx 22rpx rgba(35,42,54,.08); }
.category-dot { display: none; }
.category.active .category-dot { display: block; position: absolute; left: 4rpx; top: 50%; width: 7rpx; height: 28rpx; margin-top: -14rpx; border-radius: 9rpx; background: #ff6840; }
.products { flex: 1; height: 100%; box-sizing: border-box; }
.category-heading { padding: 4rpx 2rpx 18rpx; font-size: 31rpx; font-weight: 700; }
.category-heading text { margin-left: 12rpx; color: #969ba4; font-size: 21rpx; font-weight: 400; }
.product-card { display: flex; gap: 18rpx; padding: 18rpx; margin-bottom: 18rpx; border-radius: 28rpx; background: rgba(255,255,255,.93); box-shadow: 0 12rpx 36rpx rgba(32,40,54,.06); }
.product-visual { flex: 0 0 104rpx; width: 104rpx; height: 104rpx; border-radius: 25rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg,#fff0e9,#ffd9c8); color: #ef6139; font-size: 42rpx; font-weight: 750; }
.product-visual image { width: 100%; height: 100%; border-radius: 25rpx; }
.product-info { min-width: 0; flex: 1; }
.product-name { font-size: 29rpx; font-weight: 700; }
.description { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #969ba4; font-size: 21rpx; margin: 7rpx 0 10rpx; }
.sku { padding: 7rpx 0; }
.sku-name { color: #6f747d; font-size: 21rpx; }
.currency { color: #f0552d; font-size: 20rpx; margin-right: 2rpx; }
.price { font-size: 29rpx; }
.add { margin: 0; width: 58rpx; min-width: 58rpx; height: 58rpx; line-height: 54rpx; border-radius: 19rpx; background: #1d1f23; color: #fff; font-size: 31rpx; padding: 0; box-shadow: 0 8rpx 18rpx rgba(18,20,24,.18); }
