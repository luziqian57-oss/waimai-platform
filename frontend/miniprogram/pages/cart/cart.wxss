.cart-page { padding-top: 34rpx; }
.page-heading { padding: 8rpx 6rpx 30rpx; }
.page-heading .title { margin-top: 10rpx; font-size: 50rpx; }
.empty-button { width: 260rpx; margin-top: 34rpx; }
.address { display: flex; gap: 20rpx; }
.address-icon { width: 72rpx; height: 72rpx; flex: 0 0 72rpx; line-height: 72rpx; text-align: center; border-radius: 22rpx; background: #fff0e9; color: #f05a32; font-size: 34rpx; }
.address-content { min-width: 0; flex: 1; }
.address-name, .item-name { font-weight: 700; }
.address-detail { margin-top: 8rpx; line-height: 1.45; font-size: 25rpx; }
.order-list { padding-bottom: 8rpx; }
.list-title { margin-bottom: 8rpx; }
.item-count { color: #969ba3; font-size: 22rpx; }
.cart-item { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 0; border-top: 1rpx solid rgba(60,60,67,.08); }
.item-visual { width: 92rpx; height: 92rpx; line-height: 92rpx; flex: 0 0 92rpx; border-radius: 24rpx; text-align: center; background: linear-gradient(145deg,#fff0e9,#ffd9c9); color: #ef6038; font-size: 36rpx; font-weight: 700; }
.item-visual image { width: 100%; height: 100%; border-radius: 24rpx; }
.item-main { min-width: 0; flex: 1; }
.stepper { padding: 5rpx; border-radius: 999rpx; background: rgba(118,118,128,.08); }
.stepper button { width: 50rpx; min-width: 50rpx; height: 50rpx; line-height: 46rpx; padding: 0; margin: 0; border-radius: 50%; background: transparent; color: #30343a; font-size: 28rpx; }
.stepper text { min-width: 42rpx; text-align: center; font-weight: 650; }
.stepper .stepper-add { background: #1e2024; color: #fff; }
.summary-line { padding: 12rpx 0; color: #777d86; font-size: 25rpx; }
.free { color: #278a47; }
.divider { height: 1rpx; margin: 16rpx 0; background: rgba(60,60,67,.09); }
.summary-total { font-size: 28rpx; font-weight: 650; }
.summary-total view { color: #f0552d; font-size: 38rpx; }
.currency { font-size: 22rpx; }
.checkout { position: fixed; z-index: 5; left: 24rpx; right: 24rpx; bottom: 126rpx; border-radius: 34rpx; padding: 15rpx 17rpx 15rpx 30rpx; }
.checkout-label { color: #8a9099; font-size: 20rpx; }
.total { color: #17191d; font-size: 38rpx; font-weight: 750; }
.pay { margin: 0; width: 250rpx; }
